{
  "name": "@react-agendfy/fullcalendar-compat",
  "version": "0.0.0",
  "description": "Drop-in replacement for @fullcalendar/react on top of react-agendfy: same props, callbacks (info objects, EventApi, revert) and getApi().",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist",
    "MIGRATING.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "calendar",
    "fullcalendar",
    "migration",
    "agendfy",
    "scheduler"
  ],
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@react-agendfy/core": "workspace:^",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@react-agendfy/core": "workspace:^",
    "babel-jest": "^30.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.0"
  }
}
