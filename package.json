{
  "name": "react-agendfy",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/plugins/*",
    "examples/*"
  ],
  "version": "1.1.10",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "bootstrap": "pnpm install",
    "build:packages": "pnpm -r --filter \"./packages/**\" run build",
    "test:packages": "pnpm --filter @react-agendfy/core --filter @react-agendfy/ai --filter @react-agendfy/fullcalendar-compat --filter @react-agendfy/gantt --filter @react-agendfy/plugin-timeline test",
    "test": "jest",
    "lint": "eslint .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zebedeu/react-agendfy.git"
  },
  "author": "Márcio Zebedeu",
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "babel-jest": "^30.5.2",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "lucide-react": "^1.70.0",
    "uuid": "^14.0.3"
  },
  "packageManager": "pnpm@12.11.2"
}
