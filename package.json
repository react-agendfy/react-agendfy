{
  "name": "react-agendfy",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/plugins/*",
    "examples/*"
  ],
  "version": "1.1.10",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "bootstrap": "yarn install",
    "build:packages": "yarn workspaces foreach --all --topological --no-private -v run build",
    "test:packages": "yarn workspaces foreach --all run test",
    "test": "jest",
    "lint": "eslint .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zebedeu/react-agendfy.git"
  },
  "author": "Márcio Zebedeu",
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@changesets/cli": "^2.31.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-jest": "^30.2.0",
    "eslint": "^9.38.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.1.0"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "packageManager": "yarn@4.10.3",
  "dependencies": {
    "lucide-react": "^0.548.0",
    "uuid": "^13.0.0"
  }
}
